@startuml
' Certification hierarchies and publication channel of the derived Trust Anchors.

skinparam shadowing false
skinparam defaultFontName Helvetica
skinparam defaultFontSize 12
skinparam ArrowColor #444444
skinparam rectangle {
  BackgroundColor White
  BorderColor #444444
}
skinparam package {
  BackgroundColor #FAFAFA
  BorderColor #888888
  FontStyle bold
}

left to right direction

package "National PKI" as NAT {

  rectangle "National Root CA\n//offline, outside the validation path//" as ROOT

  rectangle "PID Provider Sign/Seal CA\n//PID Provider Sign/Seal Certificates//" as CA_PIDS
  rectangle "Wallet Provider Sign/Seal CA\n//Wallet Provider Sign/Seal Certificates//" as CA_WP
  
  rectangle "WRPAC CA\nAccess certificates of Wallet-Relying Parties " as CA_WRPAC
  rectangle "National Authentication CA\n//Relying Party authentication certificates//" as CA_AUTH
  rectangle "WRPRC Sign/Seal CA\n//Sign/Seal certificates of the Provider of WRPRC//" as CA_WRPRC
  rectangle "Registrar Sign/Seal CA\n//Registrar Sign/Seal Certificates//" as CA_REG
  rectangle "National EAA Sign/Seal CA\n//Document Signer certificates//" as CA_EAA
}

package "Qualified Trust Service Provider" as QTSP {
  rectangle "Qualified CA\n//QEAA Provider Sign/Seal Certificates//" as CA_Q
  rectangle "Qualified CA\n//PuB-EAA Provider Sign/Seal Certificates//" as CA_PUB
}

package "EUDIW Trust Framework" as PUBEU {
  rectangle "PID Providers\nList of Trusted Entities" as L_PID
  rectangle "Wallet Providers\nList of Trusted Entities" as L_WP
  ' rectangle "PuB-EAA Providers\nList of Trusted Entities" as L_PUB
  rectangle "Providers of WRPAC\nList of Trusted Entities" as L_WRPAC
  rectangle "Providers of WRPRC\nList of Trusted Entities" as L_WRPRC
  rectangle "Registrar\nList of Trusted Entities" as L_REG
  rectangle "Member State Trusted List\n//Article 22 of eIDAS//" as L_TL
}

package "National Trust Framework" as PUBNAT {
  rectangle "Federation Trust Anchor\nEntity Configuration" as L_FED
  note bottom
    The Federation Entity Keys are published as JWK
    in the Entity Configurations. They are not X.509
    certificates and are not issued by a Certification
    Authority.
  end note  
}

ROOT --> CA_PIDS
ROOT --> CA_WP
ROOT --> CA_WRPAC
ROOT --> CA_AUTH
ROOT --> CA_WRPRC
ROOT --> CA_REG
ROOT --> CA_EAA

CA_PIDS ..> L_PID
CA_WP ..> L_WP
CA_PUB ..> L_TL
CA_WRPAC ..> L_WRPAC
CA_WRPAC ..> L_PID
CA_WRPRC ..> L_WRPRC
CA_REG ..> L_REG
CA_Q ..> L_TL
CA_WP ..> L_FED : //Wallet Trsut Anchor//
CA_AUTH ..> L_FED : //Authentication Trust Anchor//
CA_EAA ..> L_FED : //Signing Trust Anchor//

' note bottom of PUBNAT
'   The Federation Entity Keys are published as JWK
'   in the Entity Configurations. They are not X.509
'   certificates and are not issued by a Certification
'   Authority.
' end note

legend bottom
  Solid arrow: issues the certificate of the subordinate Certification Authority.
  Dashed arrow: the Certification Authority certificate is published as Trust Anchor in.
endlegend
@enduml